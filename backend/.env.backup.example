# Papel de backup (unishop_backup): somente leitura. Copie para backend/.env.backup (ignorado pelo git).
# É lido só pelo pg_dump (manual ou workflow do GitHub Actions). A API NÃO carrega este arquivo:
# o src/config/env.ts lê apenas o .env. No GitHub, o mesmo valor vai como segredo
# DATABASE_URL_BACKUP (Settings > Secrets and variables > Actions).
#
# Session pooler (porta 5432), usuário = papel.ref-do-projeto. Senha com @ ? # / : % [ ] precisa ser
# codificada em URL (@ = %40, ? = %3F, # = %23, / = %2F, : = %3A, % = %25).
# Sem uselibpqcompat: esse parâmetro é do Prisma/Node e o pg_dump (libpq) o rejeita.
# pg_dump sempre com --schema=public --enable-row-security (sem a 2ª flag o papel sem BYPASSRLS recebe erro de RLS).
# Uma linha só: NAO repita o nome da variável dentro das aspas.
DATABASE_URL_BACKUP="postgresql://unishop_backup.<ref-do-projeto>:<senha-codificada>@<host-do-pooler>:5432/postgres?sslmode=require"
