NODE_ENV=development
PORT=3000
# Desenvolvimento: Docker Compose (um usuário só). Produção/preview: um papel por conexão, no pooler do Supabase
# (usuário = papel.ref-do-projeto; senha com @ # / codificada em URL).
#   unishop_app      -> aqui, Transaction pooler (6543): postgresql://unishop_app.<ref>:<senha>@<host-pooler>:6543/postgres?pgbouncer=true&connection_limit=1&uselibpqcompat=true&sslmode=require
#   unishop_migrator -> DATABASE_URL_UNPOOLED, Session pooler (5432): ...@<host-pooler>:5432/postgres?uselibpqcompat=true&sslmode=require
#   unishop_backup   -> fora deste arquivo: backend/.env.backup (modelo em .env.backup.example)
DATABASE_URL=postgresql://dev:dev@localhost:5432/unishop_dev
DATABASE_URL_UNPOOLED=       # unishop_migrator; migração e seed; só em produção
APP_ENV=development          # development | test | preview | production
FRONTEND_URL=http://localhost:5173   # uma ou mais origens, separadas por vírgula

JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRES_IN=2h
ALLOWED_EMAIL_DOMAIN=edu.unifor.br

GOOGLE_CLIENT_ID=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=no-reply@seudominio.com
CLOUDINARY_URL=

SERVICE_FEE_PERCENT=0        # taxa R$ 0,00 por enquanto (RN-PED-02)
PIX_EXPIRATION_MINUTES=30    # validade do Pix (RN-PAG-04) e do pedido pendente (RN-PAG-12)
EMAIL_VERIFICATION_REQUIRED=false   # confirmação de e-mail por link: desligada no MVP (RN-ACE-07)
LOGIN_MAX_ATTEMPTS=5         # RN-ACE-09
LOGIN_LOCK_MINUTES=15

CRON_SECRET=                 # senha dos endpoints de jobs (produção)

PAYMENT_MODE=sandbox         # sandbox = credenciais de teste (RN-PAG-10)
PAYMENT_DRIVER=mock          # mock | mercadopago
MAIL_DRIVER=console          # console | mailtrap | resend
STORAGE_DRIVER=local         # local | cloudinary
CLOUDINARY_UPLOAD_FOLDER=unishop-dev
ANTIBOT_DRIVER=noop          # noop | turnstile (depois do MVP)

ADMIN_EMAIL=                 # usados só pelo seed (RN-ADM-11)
ADMIN_PASSWORD=
