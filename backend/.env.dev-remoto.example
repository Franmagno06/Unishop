# Banco REMOTO de desenvolvimento e preview (projeto Supabase "unishop-dev").
# Copie para backend/.env.dev-remoto (ignorado pelo git). NUNCA coloque aqui a URL do unishop-prod.
# Não substitui o backend/.env: serve só para migrar/semear o unishop-dev ou testar contra ele.
# A API NÃO carrega este arquivo (o src/config/env.ts lê só o .env). Carregue as variáveis no terminal.
#
# Origem das URLs: Supabase > unishop-dev > botão Connect > aba ORM > Prisma. Copie o host pelo Connect.
# Senha sem os colchetes do modelo do Supabase; caracteres reservados codificados em URL
# (@ = %40, ? = %3F, # = %23, / = %2F, : = %3A, % = %25).
# Pelo pooler o usuário é papel.ref-do-projeto (ex.: unishop_app.abcdefgh).

# API: papel unishop_app, Transaction pooler (6543)
DATABASE_URL="postgresql://unishop_app.<ref-do-unishop-dev>:<senha-codificada>@<host-do-pooler>:6543/postgres?pgbouncer=true&connection_limit=1&uselibpqcompat=true&sslmode=require"

# Migrações e seed: papel unishop_migrator, Session pooler (5432)
DATABASE_URL_UNPOOLED="postgresql://unishop_migrator.<ref-do-unishop-dev>:<senha-codificada>@<host-do-pooler>:5432/postgres?uselibpqcompat=true&sslmode=require"

# Backup: papel unishop_backup, Session pooler (5432). Sem uselibpqcompat (o pg_dump rejeita).
DATABASE_URL_BACKUP="postgresql://unishop_backup.<ref-do-unishop-dev>:<senha-codificada>@<host-do-pooler>:5432/postgres?sslmode=require"

# Seed (só para o unishop-dev; prefira digitar a senha no terminal em vez de gravá-la aqui)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
